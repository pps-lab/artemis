diff --git a/provekit/r1cs-compiler/src/artemis.rs b/provekit/r1cs-compiler/src/artemis.rs
new file mode 100644
index 00000000..91005f0d
--- /dev/null
+++ b/provekit/r1cs-compiler/src/artemis.rs
@@ -0,0 +1,164 @@
+//! Artemis commit-and-prove link.
+//!
+//! The link ties a private `[u8; N]` parameter of the Noir program (the
+//! payload) to an external homomorphic commitment, without recomputing the
+//! commitment in the circuit. The payload is packed into field elements
+//! `u_0..u_{k-1}` (`bytes_per_element` bytes each, little endian) and the
+//! circuit computes
+//!
+//! ```text
+//! rho = beta * (u_0 + u_1 beta + ... + u_{k-1} beta^{k-1} + mask * beta^k)
+//! ```
+//!
+//! for a challenge `beta` drawn after the first witness block (which holds
+//! the payload and the mask) is committed. `rho` lives in the second block
+//! and is revealed to the verifier, who checks an opening of the external
+//! commitment at `beta` to `rho / beta`.
+//!
+//! The Horner recurrence costs `k + 1` multiplication constraints. Packing is
+//! a linear combination and costs none. The trailing factor `beta` makes every
+//! packed element feed a product with the challenge, which is what forces the
+//! witness splitter to place the payload in the first block; the compiler
+//! re-checks that placement after the split.
+
+use {
+    crate::noir_to_r1cs::NoirToR1CSCompiler,
+    acir::native_types::Witness as NoirWitness,
+    anyhow::{bail, ensure, Context as _, Result},
+    ark_ff::{Field, One},
+    noirc_abi::{Abi, AbiType, Sign},
+    provekit_backend_bn254::{
+        witness::{SumTerm, WitnessBuilder},
+        FieldElement,
+    },
+    std::collections::HashSet,
+};
+
+/// Which parameters of `main` take part in the link.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ArtemisConfig {
+    /// Name of the private `[u8; N]` parameter holding the committed bytes.
+    pub payload:           String,
+    /// Name of the private `Field` parameter holding the mask coefficient.
+    pub mask:              String,
+    /// Bytes packed into one field element.
+    pub bytes_per_element: usize,
+}
+
+impl Default for ArtemisConfig {
+    fn default() -> Self {
+        Self {
+            payload:           "payload".into(),
+            mask:              "mask".into(),
+            bytes_per_element: 31,
+        }
+    }
+}
+
+/// ACIR witness indices of the linked parameters.
+#[derive(Debug, Clone)]
+pub(crate) struct LinkedParams {
+    pub(crate) payload: Vec<u32>,
+    pub(crate) mask:    u32,
+}
+
+impl LinkedParams {
+    pub(crate) fn all(&self) -> impl Iterator<Item = u32> + '_ {
+        self.payload.iter().copied().chain([self.mask])
+    }
+}
+
+/// Locate the linked parameters in the ABI. `main` parameters occupy ACIR
+/// witnesses `0..` in declaration order.
+pub(crate) fn locate_params(abi: &Abi, config: &ArtemisConfig) -> Result<LinkedParams> {
+    ensure!(
+        (1..=31).contains(&config.bytes_per_element),
+        "bytes_per_element must be in 1..=31 so a packed element fits the field"
+    );
+    let (mut payload, mut mask) = (None, None);
+    let mut next = 0u32;
+    for param in &abi.parameters {
+        let count = param.typ.field_count();
+        if param.name == config.payload {
+            ensure!(
+                param.visibility == noirc_abi::AbiVisibility::Private,
+                "the linked payload must be a private parameter"
+            );
+            match &param.typ {
+                AbiType::Array { typ, .. }
+                    if matches!(**typ, AbiType::Integer {
+                        sign: Sign::Unsigned,
+                        width: 8,
+                    }) => {}
+                other => bail!("the linked payload must be a [u8; N], found {other:?}"),
+            }
+            payload = Some((next..next + count).collect::<Vec<_>>());
+        } else if param.name == config.mask {
+            ensure!(
+                param.visibility == noirc_abi::AbiVisibility::Private
+                    && matches!(param.typ, AbiType::Field),
+                "the mask must be a private Field parameter"
+            );
+            mask = Some(next);
+        }
+        next += count;
+    }
+    Ok(LinkedParams {
+        payload: payload
+            .with_context(|| format!("no parameter named `{}` in main", config.payload))?,
+        mask:    mask.with_context(|| format!("no parameter named `{}` in main", config.mask))?,
+    })
+}
+
+/// Add the link constraints. Returns the R1CS columns that must stay
+/// committed witnesses (payload bytes, mask, `rho`).
+pub(crate) fn add_link(
+    compiler: &mut NoirToR1CSCompiler,
+    params: &LinkedParams,
+    bytes_per_element: usize,
+) -> HashSet<usize> {
+    let bytes: Vec<usize> = params
+        .payload
+        .iter()
+        .map(|w| compiler.fetch_r1cs_witness_index(NoirWitness(*w)))
+        .collect();
+    let mask = compiler.fetch_r1cs_witness_index(NoirWitness(params.mask));
+    let beta =
+        compiler.add_witness_builder(WitnessBuilder::Challenge(compiler.num_witnesses()));
+
+    let radix = FieldElement::from(256u64);
+    let mut acc = mask;
+    for chunk in bytes.chunks(bytes_per_element).rev() {
+        let shifted = compiler.add_product(acc, beta);
+        let mut terms = Vec::with_capacity(chunk.len() + 1);
+        terms.push(SumTerm(None, shifted));
+        let mut weight = FieldElement::one();
+        for byte in chunk {
+            terms.push(SumTerm(Some(weight), *byte));
+            weight *= radix;
+        }
+        acc = compiler.add_sum(terms);
+    }
+    let rho = compiler.add_witness_builder(WitnessBuilder::ArtemisEval(
+        compiler.num_witnesses(),
+        acc,
+        beta,
+    ));
+    compiler.r1cs.add_constraint(
+        &[(FieldElement::one(), acc)],
+        &[(FieldElement::one(), beta)],
+        &[(FieldElement::one(), rho)],
+    );
+
+    let mut protected: HashSet<usize> = bytes.into_iter().collect();
+    protected.insert(mask);
+    protected.insert(rho);
+    protected
+}
+
+/// The verifier-side relation between the revealed `rho`, the challenge
+/// `beta`, and the evaluation of the committed polynomial `(u, mask)` at
+/// `beta`. Returns `None` for `beta = 0`, which the verifier must reject.
+pub fn committed_evaluation(rho: FieldElement, beta: FieldElement) -> Option<FieldElement> {
+    beta.inverse().map(|inv| rho * inv)
+}

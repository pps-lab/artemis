diff --git a/tooling/artemis-bench/src/lib.rs b/tooling/artemis-bench/src/lib.rs
new file mode 100644
index 00000000..bb8786d3
--- /dev/null
+++ b/tooling/artemis-bench/src/lib.rs
@@ -0,0 +1,285 @@
+//! Artemis commit-and-prove link on ProveKit.
+//!
+//! The ProveKit proof shows a predicate over a private `payload: [u8; N]` and
+//! reveals `rho`, the masked evaluation of the packed payload at a challenge
+//! `beta` drawn after the payload is committed (see
+//! `provekit_r1cs_compiler::ArtemisConfig`). An IPA opening of the external
+//! Pedersen commitment at `beta` then ties the payload in the proof to the
+//! commitment. The external commitments are bound into the transcript through
+//! the domain separator's session id, before `beta` is drawn.
+
+use {
+    acir::AcirField as _,
+    anyhow::{anyhow, bail, ensure, Context as _, Result},
+    ark_ec::CurveGroup,
+    ark_serialize::CanonicalSerialize,
+    nargo::{
+        insert_all_files_for_workspace_into_file_manager,
+        ops::{check_program, compile_program, report_errors},
+        parse_all,
+    },
+    nargo_toml::{get_package_manifest, resolve_workspace_from_toml, PackageSelection},
+    noirc_abi::{input_parser::InputValue, InputMap},
+    noirc_artifacts::program::ProgramArtifact,
+    noirc_driver::{CompileOptions, NOIR_ARTIFACT_VERSION_STRING},
+    provekit_backend_bn254::{
+        noir_to_native, Bn254Field, FieldElement, NoirProofScheme, NoirProver, Prover, Verifier,
+    },
+    provekit_common::{HashConfig, ProvekitProof, WitnessCommitmentMode},
+    provekit_r1cs_compiler::{committed_evaluation, ArtemisConfig, NoirCompiler},
+    sha2::{Digest, Sha256},
+    std::path::Path,
+    tlsn_bench_pcs::{ipa, G1Affine},
+};
+
+pub use provekit_r1cs_compiler::ArtemisConfig as LinkConfig;
+
+/// Compile the Noir package in `dir` with the Noir version ProveKit pins.
+pub fn compile_package(dir: &Path) -> Result<ProgramArtifact> {
+    let dir = std::fs::canonicalize(dir).with_context(|| format!("no such dir {dir:?}"))?;
+    let workspace = resolve_workspace_from_toml(
+        &get_package_manifest(&dir)?,
+        PackageSelection::DefaultOrAll,
+        Some(NOIR_ARTIFACT_VERSION_STRING.to_owned()),
+    )?;
+    let options = CompileOptions {
+        silence_warnings: true,
+        ..CompileOptions::default()
+    };
+    let mut file_manager = workspace.new_file_manager();
+    insert_all_files_for_workspace_into_file_manager(&workspace, &mut file_manager);
+    let parsed_files = parse_all(&file_manager);
+    let package = workspace
+        .into_iter()
+        .find(|p| p.is_binary())
+        .context("no binary package")?;
+    let result = compile_program(
+        &file_manager,
+        &parsed_files,
+        &workspace,
+        package,
+        &options,
+        None,
+    )
+    .and_then(|(program, warnings)| {
+        check_program(&program)?;
+        Ok((program, warnings))
+    });
+    let program = report_errors(result, &file_manager, &parsed_files, false, true)
+        .map_err(|e| anyhow!("Noir compilation failed: {e}"))?;
+    Ok(program.into())
+}
+
+/// Build the ProveKit scheme, with the Artemis link when `link` is set.
+pub fn build_scheme(program: ProgramArtifact, link: Option<&ArtemisConfig>) -> Result<NoirProofScheme> {
+    NoirCompiler::from_program_linked(
+        program,
+        HashConfig::default(),
+        WitnessCommitmentMode::default(),
+        link,
+    )
+}
+
+/// Split a compiled scheme into the prover and verifier keys.
+pub fn keys(scheme: NoirProofScheme) -> (Prover, Verifier) {
+    (
+        Prover::from_noir_proof_scheme(scheme.clone()),
+        Verifier::from_noir_proof_scheme(scheme),
+    )
+}
+
+/// The committed coefficient vector: the packed payload followed by the mask.
+pub struct Committed {
+    pub coeffs: Vec<FieldElement>,
+}
+
+impl Committed {
+    /// Read the linked parameters from the prover inputs.
+    pub fn from_inputs(inputs: &InputMap, config: &ArtemisConfig) -> Result<Self> {
+        let bytes: Vec<u8> = match inputs.get(&config.payload) {
+            Some(InputValue::Vec(values)) => values
+                .iter()
+                .map(|v| match v {
+                    InputValue::Field(f) => {
+                        let n = f.to_u128();
+                        ensure!(n < 256, "payload element is not a byte");
+                        Ok(n as u8)
+                    }
+                    _ => bail!("payload element is not a field"),
+                })
+                .collect::<Result<_>>()?,
+            _ => bail!("input `{}` missing or not an array", config.payload),
+        };
+        let mask = match inputs.get(&config.mask) {
+            Some(InputValue::Field(f)) => noir_to_native(*f),
+            _ => bail!("input `{}` missing or not a field", config.mask),
+        };
+        ensure!(
+            config.bytes_per_element == 31,
+            "the external commitment packs 31 bytes per element"
+        );
+        let mut coeffs = tlsn_bench_pcs::pack_bytes(&bytes);
+        coeffs.push(mask);
+        Ok(Self { coeffs })
+    }
+
+    /// Number of packed payload elements (the mask sits at this index).
+    pub fn payload_len(&self) -> usize {
+        self.coeffs.len() - 1
+    }
+}
+
+/// The external commitments: `c` to the payload (in a deployment this comes
+/// from the TLSNotary session) and `c_mu` to the mask (chosen by the prover).
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Commitments {
+    pub c:    G1Affine,
+    pub c_mu: G1Affine,
+}
+
+impl Commitments {
+    /// Transcript session id: binds both commitments before `beta` is drawn.
+    pub fn session(&self) -> [u8; 32] {
+        let mut bytes = Vec::with_capacity(64);
+        self.c
+            .serialize_compressed(&mut bytes)
+            .expect("serializing to a Vec");
+        self.c_mu
+            .serialize_compressed(&mut bytes)
+            .expect("serializing to a Vec");
+        let mut h = Sha256::new();
+        h.update(b"artemis-provekit/session/v1");
+        h.update(&bytes);
+        h.finalize().into()
+    }
+
+    /// The commitment to the masked polynomial.
+    pub fn combined(&self) -> G1Affine {
+        (self.c + self.c_mu).into_affine()
+    }
+}
+
+/// Blinding factors of the two commitments.
+#[derive(Clone, Copy, Debug)]
+pub struct Blinds {
+    pub r:    FieldElement,
+    pub r_mu: FieldElement,
+}
+
+/// Commit to the payload and to the mask.
+pub fn commit(ck: &ipa::CommitKey, committed: &Committed, blinds: Blinds) -> Commitments {
+    let k = committed.payload_len();
+    Commitments {
+        c:    ck.commit(&committed.coeffs[..k], blinds.r).into_affine(),
+        c_mu: ck
+            .commit_at(k, &committed.coeffs[k..], blinds.r_mu)
+            .into_affine(),
+    }
+}
+
+/// An Artemis proof: the ProveKit proof (which carries `rho`), the mask
+/// commitment and the opening of `c + c_mu` at `beta`.
+#[derive(Clone, Debug)]
+pub struct LinkedProof {
+    pub proof:   ProvekitProof<Bn254Field>,
+    pub c_mu:    G1Affine,
+    pub opening: ipa::Proof,
+}
+
+impl LinkedProof {
+    /// Proof size in bytes: ProveKit transcript and hints, public inputs, the
+    /// mask commitment and the opening (points compressed).
+    pub fn size_bytes(&self) -> usize {
+        proof_size_bytes(&self.proof) + 32 + self.opening.size_bytes()
+    }
+}
+
+/// Size of a ProveKit proof: transcript, hints and public inputs.
+pub fn proof_size_bytes(proof: &ProvekitProof<Bn254Field>) -> usize {
+    proof.whir_r1cs_proof.narg_string.len()
+        + proof.whir_r1cs_proof.hints.len()
+        + 32 * proof.public_inputs.len()
+}
+
+/// Wall-clock split of [`prove_linked`], in seconds.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct ProveTimes {
+    pub snark:   f64,
+    pub opening: f64,
+}
+
+/// Produce the linked proof from a solved ACIR witness.
+pub fn prove_linked(
+    prover: NoirProver,
+    acir_witness: acir::native_types::WitnessMap<provekit_backend_bn254::NoirElement>,
+    ck: &ipa::CommitKey,
+    committed: &Committed,
+    commitments: &Commitments,
+    blinds: Blinds,
+) -> Result<(LinkedProof, ProveTimes)> {
+    let link_challenge = prover
+        .whir_for_witness
+        .link_challenge
+        .context("prover key has no Artemis link")?;
+    let t = std::time::Instant::now();
+    let (proof, linked) = prover.prove_linked(acir_witness, Some(commitments.session()))?;
+    let snark = t.elapsed().as_secs_f64();
+
+    let t = std::time::Instant::now();
+    let beta = linked.challenges[link_challenge];
+    let rho = *linked.exposed.first().context("no revealed value")?;
+    let value = committed_evaluation(rho, beta).context("link challenge is zero")?;
+    let opening = ipa::open(
+        ck,
+        &committed.coeffs,
+        blinds.r + blinds.r_mu,
+        &commitments.combined(),
+        beta,
+        value,
+        &mut ark_std::rand::thread_rng(),
+    );
+    let opening_time = t.elapsed().as_secs_f64();
+    Ok((
+        LinkedProof {
+            proof,
+            c_mu: commitments.c_mu,
+            opening,
+        },
+        ProveTimes {
+            snark,
+            opening: opening_time,
+        },
+    ))
+}
+
+/// Verify a linked proof against the payload commitment `c`.
+pub fn verify_linked(
+    verifier: &Verifier,
+    ck: &ipa::CommitKey,
+    c: &G1Affine,
+    proof: &LinkedProof,
+) -> Result<()> {
+    let scheme = verifier
+        .whir_for_witness
+        .as_ref()
+        .context("verifier key has no witness scheme")?;
+    let link_challenge = scheme
+        .link_challenge
+        .context("verifier key has no Artemis link")?;
+    ensure!(
+        scheme.exposed_offsets.len() == 1,
+        "verifier key must reveal exactly one value"
+    );
+    let commitments = Commitments {
+        c:    *c,
+        c_mu: proof.c_mu,
+    };
+    let linked = verifier.verify_linked(&proof.proof, &commitments.session())?;
+    let beta = linked.challenges[link_challenge];
+    let value = committed_evaluation(linked.exposed[0], beta).context("link challenge is zero")?;
+    ensure!(
+        ipa::verify(ck, &commitments.combined(), beta, value, &proof.opening),
+        "opening of the external commitment failed"
+    );
+    Ok(())
+}
diff --git a/tooling/artemis-bench/src/main.rs b/tooling/artemis-bench/src/main.rs
new file mode 100644
index 00000000..ebb41790
--- /dev/null
+++ b/tooling/artemis-bench/src/main.rs
@@ -0,0 +1,231 @@
+//! Benchmark driver. Two subcommands, run as separate processes so that the
+//! peak memory of `prove` does not include compilation and key generation:
+//!
+//! * `prepare`: compile a Noir package, build the R1CS and write the keys.
+//! * `prove`: load the keys, prove once, verify `--verify-reps` times, and
+//!   print one JSON object with the measurements.
+
+use {
+    anyhow::{Context as _, Result},
+    argh::FromArgs,
+    ark_ff::UniformRand,
+    artemis_bench::{
+        build_scheme, commit, compile_package, keys, proof_size_bytes, prove_linked,
+        verify_linked, Blinds, Committed, LinkConfig,
+    },
+    noir_artifact_cli::fs::inputs::read_inputs_from_file,
+    provekit_backend_bn254::{FieldElement, Prover, Verifier, Verify},
+    provekit_common::file::{read, write},
+    serde_json::json,
+    std::{path::PathBuf, time::Instant},
+    tlsn_bench_pcs::ipa,
+};
+
+#[derive(FromArgs)]
+/// Artemis on ProveKit: benchmark driver.
+struct Args {
+    #[argh(subcommand)]
+    cmd: Cmd,
+}
+
+#[derive(FromArgs)]
+#[argh(subcommand)]
+enum Cmd {
+    Prepare(Prepare),
+    Prove(Prove),
+}
+
+#[derive(FromArgs)]
+/// Compile a Noir package and write prover.pkp / verifier.pkv.
+#[argh(subcommand, name = "prepare")]
+struct Prepare {
+    /// noir package directory
+    #[argh(option)]
+    circuit: PathBuf,
+    /// output directory for the keys
+    #[argh(option)]
+    out:     PathBuf,
+    /// add the Artemis link for parameters `payload` and `mask`
+    #[argh(switch)]
+    artemis: bool,
+}
+
+#[derive(FromArgs)]
+/// Prove once and verify.
+#[argh(subcommand, name = "prove")]
+struct Prove {
+    /// directory holding the keys
+    #[argh(option)]
+    keys:        PathBuf,
+    /// prover inputs (Prover.toml)
+    #[argh(option)]
+    input:       PathBuf,
+    /// the keys carry an Artemis link
+    #[argh(switch)]
+    artemis:     bool,
+    /// number of verifier repetitions
+    #[argh(option, default = "5")]
+    verify_reps: usize,
+}
+
+/// Peak resident set size of this process in bytes.
+fn max_rss_bytes() -> u64 {
+    // SAFETY: `getrusage` only writes into the struct we pass.
+    let usage = unsafe {
+        let mut usage = std::mem::zeroed::<Rusage>();
+        getrusage(0, &mut usage);
+        usage
+    };
+    let raw = usage.ru_maxrss as u64;
+    if cfg!(target_os = "macos") {
+        raw
+    } else {
+        raw * 1024
+    }
+}
+
+#[repr(C)]
+struct Rusage {
+    ru_utime:  [i64; 2],
+    ru_stime:  [i64; 2],
+    ru_maxrss: i64,
+    rest:      [i64; 13],
+}
+
+extern "C" {
+    fn getrusage(who: i32, usage: *mut Rusage) -> i32;
+}
+
+fn mean_std(xs: &[f64]) -> (f64, f64) {
+    let n = xs.len() as f64;
+    let mean = xs.iter().sum::<f64>() / n;
+    let var = xs.iter().map(|x| (x - mean).powi(2)).sum::<f64>() / n;
+    (mean, var.sqrt())
+}
+
+fn prepare(args: Prepare) -> Result<()> {
+    let t = Instant::now();
+    let program = compile_package(&args.circuit)?;
+    let compile_s = t.elapsed().as_secs_f64();
+    let acir_opcodes = program.bytecode.functions[0].opcodes.len();
+    let t = Instant::now();
+    let config = LinkConfig::default();
+    let scheme = build_scheme(program, args.artemis.then_some(&config))?;
+    let (prover, verifier) = keys(scheme);
+    let keygen_s = t.elapsed().as_secs_f64();
+    std::fs::create_dir_all(&args.out)?;
+    write(&prover, &args.out.join("prover.pkp")).context("writing prover key")?;
+    write(&verifier, &args.out.join("verifier.pkv")).context("writing verifier key")?;
+    let (constraints, witnesses) = prover.size();
+    let whir = prover.whir_for_witness();
+    println!(
+        "{}",
+        json!({
+            "acir_opcodes": acir_opcodes,
+            "constraints": constraints,
+            "witnesses": witnesses,
+            "w1_size": whir.w1_size,
+            "num_challenges": whir.num_challenges,
+            "log_witness_domain": whir.m,
+            "compile_s": compile_s,
+            "keygen_s": keygen_s,
+        })
+    );
+    Ok(())
+}
+
+fn prove(args: Prove) -> Result<()> {
+    let prover: Prover = read(&args.keys.join("prover.pkp")).context("reading prover key")?;
+    let mut verifier: Verifier =
+        read(&args.keys.join("verifier.pkv")).context("reading verifier key")?;
+    let Prover::Noir(mut prover) = prover else {
+        anyhow::bail!("expected a Noir prover key");
+    };
+    let (inputs, _) = read_inputs_from_file(&args.input, prover.witness_generator.abi())?;
+
+    let out = if args.artemis {
+        let config = LinkConfig::default();
+        let committed = Committed::from_inputs(&inputs, &config)?;
+        // Setup (not timed): transparent generators.
+        let ck = ipa::CommitKey::setup(committed.coeffs.len());
+        let mut rng = ark_std::rand::thread_rng();
+        let blinds = Blinds {
+            r:    FieldElement::rand(&mut rng),
+            r_mu: FieldElement::rand(&mut rng),
+        };
+        // Commit phase: timed, reported, not part of the prover time (the
+        // payload commitment is the CP-SNARK's input).
+        let t = Instant::now();
+        let commitments = commit(&ck, &committed, blinds);
+        let commit_s = t.elapsed().as_secs_f64();
+
+        let t = Instant::now();
+        let witness = prover.solve_acir(inputs)?;
+        let witgen_s = t.elapsed().as_secs_f64();
+
+        let (proof, times) =
+            prove_linked(prover, witness, &ck, &committed, &commitments, blinds)?;
+        let rss = max_rss_bytes();
+
+        let mut verify = Vec::with_capacity(args.verify_reps);
+        for _ in 0..args.verify_reps {
+            let t = Instant::now();
+            verify_linked(&verifier, &ck, &commitments.c, &proof)?;
+            verify.push(t.elapsed().as_secs_f64());
+        }
+        let (verify_mean, verify_std) = mean_std(&verify);
+        json!({
+            "commit_s": commit_s,
+            "witgen_s": witgen_s,
+            "snark_prove_s": times.snark,
+            "opening_s": times.opening,
+            "prover_s": times.snark + times.opening,
+            "verifier_s": verify_mean,
+            "verifier_std_s": verify_std,
+            "proof_bytes": proof.size_bytes(),
+            "snark_proof_bytes": proof_size_bytes(&proof.proof),
+            "opening_bytes": proof.opening.size_bytes() + 32,
+            "committed_elements": committed.coeffs.len(),
+            "max_rss_bytes": rss,
+        })
+    } else {
+        let t = Instant::now();
+        let witness = prover.solve_acir(inputs)?;
+        let witgen_s = t.elapsed().as_secs_f64();
+        let t = Instant::now();
+        let (proof, _) = prover.prove_linked(witness, None)?;
+        let prove_s = t.elapsed().as_secs_f64();
+        let rss = max_rss_bytes();
+
+        let mut verify = Vec::with_capacity(args.verify_reps);
+        for _ in 0..args.verify_reps {
+            // `Verify::verify` consumes the scheme; verify on a clone and
+            // keep the clone out of the timed region.
+            let mut v = verifier.clone();
+            let t = Instant::now();
+            v.verify(&proof)?;
+            verify.push(t.elapsed().as_secs_f64());
+        }
+        let _ = &mut verifier;
+        let (verify_mean, verify_std) = mean_std(&verify);
+        json!({
+            "witgen_s": witgen_s,
+            "snark_prove_s": prove_s,
+            "prover_s": prove_s,
+            "verifier_s": verify_mean,
+            "verifier_std_s": verify_std,
+            "proof_bytes": proof_size_bytes(&proof),
+            "snark_proof_bytes": proof_size_bytes(&proof),
+            "max_rss_bytes": rss,
+        })
+    };
+    println!("{out}");
+    Ok(())
+}
+
+fn main() -> Result<()> {
+    match argh::from_env::<Args>().cmd {
+        Cmd::Prepare(args) => prepare(args),
+        Cmd::Prove(args) => prove(args),
+    }
+}
diff --git a/tooling/artemis-bench/tests/soundness.rs b/tooling/artemis-bench/tests/soundness.rs
new file mode 100644
index 00000000..8a8f474d
--- /dev/null
+++ b/tooling/artemis-bench/tests/soundness.rs
@@ -0,0 +1,249 @@
+//! End-to-end and soundness tests of the Artemis link on ProveKit.
+
+use {
+    ark_ff::{One, UniformRand},
+    ark_serialize::CanonicalSerialize,
+    artemis_bench::*,
+    noir_artifact_cli::fs::inputs::read_inputs_from_file,
+    provekit_backend_bn254::{FieldElement, NoirProver, Prover, Verifier},
+    provekit_r1cs_compiler::committed_evaluation,
+    std::{fs, path::Path},
+    tlsn_bench_pcs::{eval_poly, ipa},
+};
+
+const N: usize = 100;
+
+fn write_package(dir: &Path, main: &str, payload: &[u8]) {
+    fs::create_dir_all(dir.join("src")).unwrap();
+    fs::write(
+        dir.join("Nargo.toml"),
+        "[package]\nname = \"link\"\ntype = \"bin\"\nauthors = [\"\"]\n\n[dependencies]\n",
+    )
+    .unwrap();
+    fs::write(dir.join("src/main.nr"), main).unwrap();
+    fs::write(
+        dir.join("Prover.toml"),
+        format!("payload = {payload:?}\nmask = \"0x2a\"\n"),
+    )
+    .unwrap();
+}
+
+fn main_source(visibility: &str) -> String {
+    format!(
+        "fn main(payload: {visibility} [u8; {N}], mask: Field) {{\n    assert(payload[3] != \
+         payload[4]);\n    let _ = mask;\n}}\n"
+    )
+}
+
+fn payload(seed: u8) -> Vec<u8> {
+    (0..N).map(|i| (i as u8).wrapping_mul(7).wrapping_add(seed)).collect()
+}
+
+struct Fixture {
+    prover:   NoirProver,
+    verifier: Verifier,
+    ck:       ipa::CommitKey,
+    dir:      tempfile::TempDir,
+}
+
+fn fixture(seed: u8) -> Fixture {
+    let dir = tempfile::tempdir().unwrap();
+    write_package(dir.path(), &main_source(""), &payload(seed));
+    let program = compile_package(dir.path()).unwrap();
+    let scheme = build_scheme(program, Some(&LinkConfig::default())).unwrap();
+    let (prover, verifier) = keys(scheme);
+    let Prover::Noir(prover) = prover else {
+        panic!("expected a Noir prover")
+    };
+    Fixture {
+        prover,
+        verifier,
+        ck: ipa::CommitKey::setup(N.div_ceil(31) + 1),
+        dir,
+    }
+}
+
+fn blinds() -> Blinds {
+    let mut rng = ark_std::rand::thread_rng();
+    Blinds {
+        r:    FieldElement::rand(&mut rng),
+        r_mu: FieldElement::rand(&mut rng),
+    }
+}
+
+/// Prove for the payload in the fixture's Prover.toml, opening `opened`
+/// against `commitments`.
+fn prove(
+    f: &Fixture,
+    opened: &Committed,
+    commitments: &Commitments,
+    blinds: Blinds,
+) -> LinkedProof {
+    let mut prover = f.prover.clone();
+    let (inputs, _) =
+        read_inputs_from_file(&f.dir.path().join("Prover.toml"), prover.witness_generator.abi())
+            .unwrap();
+    let witness = prover.solve_acir(inputs).unwrap();
+    prove_linked(prover, witness, &f.ck, opened, commitments, blinds)
+        .unwrap()
+        .0
+}
+
+fn committed(f: &Fixture) -> Committed {
+    let (inputs, _) = read_inputs_from_file(
+        &f.dir.path().join("Prover.toml"),
+        f.prover.witness_generator.abi(),
+    )
+    .unwrap();
+    Committed::from_inputs(&inputs, &LinkConfig::default()).unwrap()
+}
+
+#[test]
+fn honest_proof_verifies_and_rho_is_the_masked_evaluation() {
+    let f = fixture(1);
+    let committed = committed(&f);
+    let blinds = blinds();
+    let commitments = commit(&f.ck, &committed, blinds);
+    let proof = prove(&f, &committed, &commitments, blinds);
+    verify_linked(&f.verifier, &f.ck, &commitments.c, &proof).unwrap();
+
+    // rho / beta equals the committed polynomial (payload, mask) at beta.
+    let scheme = f.verifier.whir_for_witness.as_ref().unwrap();
+    let linked = f
+        .verifier
+        .verify_linked(&proof.proof, &commitments.session())
+        .unwrap();
+    let beta = linked.challenges[scheme.link_challenge.unwrap()];
+    let value = committed_evaluation(linked.exposed[0], beta).unwrap();
+    assert_eq!(value, eval_poly(&committed.coeffs, beta));
+}
+
+#[test]
+fn payload_in_the_first_witness_block() {
+    // The link is only sound if the payload and the mask are committed before
+    // beta is drawn; the compiler checks this, and so do we.
+    let f = fixture(1);
+    let scheme = &f.prover.whir_for_witness;
+    assert_eq!(scheme.exposed_offsets.len(), 1);
+    assert!(scheme.link_challenge.is_some());
+    assert!(scheme.w1_size > N);
+}
+
+#[test]
+fn commitment_to_another_payload_is_rejected() {
+    let f = fixture(1);
+    let real = committed(&f);
+    let mut other = Committed {
+        coeffs: real.coeffs.clone(),
+    };
+    other.coeffs[1] += FieldElement::one();
+    let blinds = blinds();
+    let commitments = commit(&f.ck, &other, blinds);
+
+    // The circuit ran on the real payload. Opening either polynomial against
+    // the commitment to the other payload fails.
+    let proof = prove(&f, &other, &commitments, blinds);
+    let err = verify_linked(&f.verifier, &f.ck, &commitments.c, &proof).unwrap_err();
+    assert!(err.to_string().contains("opening"), "{err}");
+    let proof = prove(&f, &real, &commitments, blinds);
+    let err = verify_linked(&f.verifier, &f.ck, &commitments.c, &proof).unwrap_err();
+    assert!(err.to_string().contains("opening"), "{err}");
+}
+
+#[test]
+fn wrong_mask_commitment_is_rejected() {
+    let f = fixture(1);
+    let committed = committed(&f);
+    let blinds = blinds();
+    let commitments = commit(&f.ck, &committed, blinds);
+    let mut proof = prove(&f, &committed, &commitments, blinds);
+    proof.c_mu = commitments.c;
+    assert!(verify_linked(&f.verifier, &f.ck, &commitments.c, &proof).is_err());
+}
+
+#[test]
+fn proof_is_bound_to_the_commitments_it_was_made_for() {
+    // Challenge reuse: a proof made under one pair of commitments does not
+    // verify under another, because beta is derived from them.
+    let f = fixture(1);
+    let committed = committed(&f);
+    let (b1, b2) = (blinds(), blinds());
+    let (c1, c2) = (commit(&f.ck, &committed, b1), commit(&f.ck, &committed, b2));
+    assert_ne!(c1, c2);
+    let p1 = prove(&f, &committed, &c1, b1);
+    let p2 = prove(&f, &committed, &c2, b2);
+    verify_linked(&f.verifier, &f.ck, &c1.c, &p1).unwrap();
+    verify_linked(&f.verifier, &f.ck, &c2.c, &p2).unwrap();
+    assert!(verify_linked(&f.verifier, &f.ck, &c2.c, &p1).is_err());
+
+    let scheme = f.verifier.whir_for_witness.as_ref().unwrap();
+    let idx = scheme.link_challenge.unwrap();
+    let beta1 = f.verifier.verify_linked(&p1.proof, &c1.session()).unwrap().challenges[idx];
+    let beta2 = f.verifier.verify_linked(&p2.proof, &c2.session()).unwrap().challenges[idx];
+    assert_ne!(beta1, beta2);
+
+    // The SNARK alone under the wrong session is rejected too.
+    assert!(f.verifier.verify_linked(&p1.proof, &c2.session()).is_err());
+}
+
+#[test]
+fn tampered_rho_is_rejected() {
+    let f = fixture(1);
+    let committed = committed(&f);
+    let blinds = blinds();
+    let commitments = commit(&f.ck, &committed, blinds);
+    let mut proof = prove(&f, &committed, &commitments, blinds);
+    let rho = f
+        .verifier
+        .verify_linked(&proof.proof, &commitments.session())
+        .unwrap()
+        .exposed[0];
+
+    // Locate rho in the transcript and replace it.
+    let mut le = Vec::new();
+    rho.serialize_compressed(&mut le).unwrap();
+    let be: Vec<u8> = le.iter().rev().copied().collect();
+    let narg = &mut proof.proof.whir_r1cs_proof.narg_string;
+    let pos = narg
+        .windows(32)
+        .position(|w| w == le.as_slice() || w == be.as_slice())
+        .expect("rho is in the transcript");
+    narg[pos + 7] ^= 1;
+    assert!(f
+        .verifier
+        .verify_linked(&proof.proof, &commitments.session())
+        .is_err());
+    assert!(verify_linked(&f.verifier, &f.ck, &commitments.c, &proof).is_err());
+}
+
+#[test]
+fn plain_verification_rejects_a_session_bound_proof() {
+    use provekit_backend_bn254::Verify;
+    let f = fixture(1);
+    let committed = committed(&f);
+    let blinds = blinds();
+    let commitments = commit(&f.ck, &committed, blinds);
+    let proof = prove(&f, &committed, &commitments, blinds);
+    let mut verifier = f.verifier.clone();
+    assert!(verifier.verify(&proof.proof).is_err());
+}
+
+#[test]
+fn public_payload_is_refused() {
+    let dir = tempfile::tempdir().unwrap();
+    write_package(dir.path(), &main_source("pub"), &payload(1));
+    let program = compile_package(dir.path()).unwrap();
+    let err = build_scheme(program, Some(&LinkConfig::default())).unwrap_err();
+    assert!(err.to_string().contains("private"), "{err}");
+}
+
+#[test]
+fn unlinked_scheme_is_unchanged() {
+    // Without a link the scheme reveals nothing.
+    let dir = tempfile::tempdir().unwrap();
+    write_package(dir.path(), &main_source(""), &payload(1));
+    let program = compile_package(dir.path()).unwrap();
+    let (prover, _) = keys(build_scheme(program, None).unwrap());
+    assert!(prover.whir_for_witness().exposed_offsets.is_empty());
+    assert!(prover.whir_for_witness().link_challenge.is_none());
+}

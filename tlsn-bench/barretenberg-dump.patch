+#include <cstdio>
+#include <cstdlib>
+#include <string>
 
 namespace bb {
 
+namespace {
+// tlsn-bench: dump of the committed wire columns (BB_DUMP_WIRES=<dir>), see tlsn-bench/README.md.
+// Layout of <dir>/wires.bin (little endian): "BBWIRES1", u64 dyadic_size, u64 active_rows, u64 masked_rows;
+// per wire (w_l, w_r, w_o, w_4): commitment x, y (32 bytes each), then masked_rows tail values (32 bytes each,
+// rows dyadic_size - masked_rows ..); then per wire active_rows values (32 bytes each, canonical form).
+template <typename FieldT> void dump_field(std::FILE* f, const FieldT& v)
+{
+    const uint256_t u(v);
+    std::fwrite(u.data, sizeof(uint64_t), 4, f);
+}
+
+template <typename Instance> void dump_wires(Instance& instance)
+{
+    const char* dir = std::getenv("BB_DUMP_WIRES");
+    if (dir == nullptr) {
+        return;
+    }
+    const std::string path = std::string(dir) + "/wires.bin";
+    std::FILE* f = std::fopen(path.c_str(), "wb");
+    if (f == nullptr) {
+        throw_or_abort("BB_DUMP_WIRES: cannot open " + path);
+    }
+    const uint64_t dyadic = instance.dyadic_size();
+    const uint64_t active = instance.get_final_active_wire_idx() + 1;
+    const uint64_t masked = instance.masking_tail_data.is_active() ? NUM_MASKED_ROWS : 0;
+    std::fwrite("BBWIRES1", 1, 8, f);
+    std::fwrite(&dyadic, 8, 1, f);
+    std::fwrite(&active, 8, 1, f);
+    std::fwrite(&masked, 8, 1, f);
+    auto& polys = instance.polynomials;
+    auto& tails = instance.masking_tail_data.tails;
+    auto& coms = instance.commitments;
+    const std::array<const decltype(polys.w_l)*, 4> wires{ &polys.w_l, &polys.w_r, &polys.w_o, &polys.w_4 };
+    const std::array<const decltype(tails.w_l)*, 4> wire_tails{ &tails.w_l, &tails.w_r, &tails.w_o, &tails.w_4 };
+    const std::array<const decltype(coms.w_l)*, 4> wire_coms{ &coms.w_l, &coms.w_r, &coms.w_o, &coms.w_4 };
+    for (size_t w = 0; w < 4; w++) {
+        dump_field(f, wire_coms[w]->x);
+        dump_field(f, wire_coms[w]->y);
+        for (uint64_t j = 0; j < masked; j++) {
+            dump_field(f, (*wire_tails[w])[dyadic - masked + j]);
+        }
+    }
+    for (size_t w = 0; w < 4; w++) {
+        for (uint64_t i = 0; i < active; i++) {
+            dump_field(f, (*wires[w])[i]);
+        }
+    }
+    std::fclose(f);
+}
+} // namespace
